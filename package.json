{
  "name": "super-outride",
  "version": "0.10.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "node tools/build/clean-dist.mjs && tsc -p tsconfig.json",
    "check": "npm run lint && npm run format:check && tsc -p tsconfig.json --noEmit",
    "test": "npm run lint && npm run format:check && npm run build && npm run build:test-assets && node --test 'tests/**/*.test.mjs'",
    "lint": "eslint src tests tools",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:test-assets": "node tools/build/build-test-ground-map.mjs",
    "build:ground": "node tools/build/build-product-ground.mjs"
  },
  "devDependencies": {
    "eslint": "10.10.0",
    "prettier": "3.9.6",
    "typescript": "^5.8.3",
    "typescript-eslint": "8.70.0"
  }
}
