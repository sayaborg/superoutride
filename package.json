{
  "name": "super-outride",
  "version": "0.10.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "node --import tsx tools/build/clean-dist.ts && tsc -p tsconfig.json && node --import tsx tools/build/build-browser-tools.ts && node --import tsx tools/build/build-content.ts",
    "check": "npm run lint && npm run format:check && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tools.json && npm run check:dependencies",
    "test": "npm run check && npm run build && node --import tsx --test 'tests/**/*.test.mjs'",
    "test:scenarios": "node --import tsx --test tests/scenarios/driving.test.mjs",
    "lint": "eslint src tests tools",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "compile:course": "node --import tsx tools/course/compile-course.ts",
    "build:sprite-lod": "node --import tsx tools/build/build-sprite-lod.ts",
    "build:sprite-source": "node --import tsx tools/build/build-sprite-source.ts",
    "course": "node --import tsx tools/course/course.ts",
    "check:dependencies": "node --test tests/infrastructure/layer-dependencies.test.mjs"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "@types/pngjs": "6.0.5",
    "esbuild": "0.28.2",
    "eslint": "10.10.0",
    "pngjs": "7.0.0",
    "prettier": "3.9.6",
    "tsx": "4.23.15",
    "typescript": "5.9.2",
    "typescript-eslint": "8.70.0"
  }
}
